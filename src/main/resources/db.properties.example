# ========================================================
# DB 접속 정보 (예시 파일)
# root-context.xml에서 <context:property-placeholder>로 읽어들인다.
# 실제 사용 시 이 파일을 복사해 db.properties로 이름 바꾸고 값을 채울 것.
#   cp db.properties.example db.properties
# db.properties는 .gitignore에 등록되어 있어 커밋되지 않는다.
# ========================================================
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/novels?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
db.username=CHANGE_ME
db.password=CHANGE_ME
