# ========================================================
# 비밀번호 찾기 메일 발송 계정 정보 (예시 파일)
# 실제 사용 시 이 파일을 복사해 mail.properties로 이름 바꾸고 값을 채울 것.
#   cp mail.properties.example mail.properties
# mail.properties는 .gitignore에 등록되어 있어 커밋되지 않는다.
# Gmail 예시: smtp.gmail.com / 587 / 앱 비밀번호(2단계 인증 필요) 사용
# ========================================================
mail.host=smtp.gmail.com
mail.port=587
mail.username=CHANGE_ME@gmail.com
mail.password=CHANGE_ME_APP_PASSWORD
